any;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;strokeColor=#34495e;" edge="1" parent="1" source="users.id" target="application_status_changes.changed_by"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="144"/><mxPoint x="580" y="808"/><mxPoint x="1098" y="808"/><mxPoint x="1098" y="470"/><mxPoint x="1574" y="470"/><mxPoint x="1574" y="264"/></Array></mxGeometry></mxCell><mxCell id="rel11" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;strokeColor=#34495e;" edge="1" parent="1" source="job_listings.id" target="job_applications.job_listing_id"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="144"/><mxPoint x="1000" y="168"/></Array></mxGeometry></mxCell><mxCell id="rel12" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;strokeColor=#34495e;" edge="1" parent="1" source="job_listings.id" target="job_match_alerts.job_listing_id"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="1014" y="144"/><mxPoint x="1014" y="612"/></Array></mxGeometry></mxCell><mxCell id="rel13" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERzeroToOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;strokeColor=#34495e;" edge="1" parent="1" source="chat_conversations.id" target="chatbot_messages.chat_conversation_id"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="1028" y="1264"/><mxPoint x="1028" y="1312"/></Array></mxGeometry></mxCell><mxCell id="rel14" value="has history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;strokeColor=#34495e;" edge="1" parent="1" source="job_applications.id" target="application_status_changes.job_application_id"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="144"/><mxPoint x="1560" y="168"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;Fiji Graduate &amp;amp; Skilled Jobseeker Employment System: Physical ERD (MySQL)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5a6b7b&quot;&gt;Group 14, IS314. Generated from the Laravel migrations: 10 application tables.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="64" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b style=&quot;font-size:13px&quot;&gt;Design notes&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Single-table users&lt;/b&gt;: jobseekers, employers, mentors and admins are rows in &lt;b&gt;users&lt;/b&gt;, identified by &lt;b&gt;role&lt;/b&gt;. Role-specific columns are grouped by section and are NULL for other roles.&lt;br&gt;• &lt;b&gt;Skills&lt;/b&gt; (users.skills) and &lt;b&gt;required skills&lt;/b&gt; (job_listings.required_skills) are JSON arrays. The predefined skill list and its categories are defined in the application (SkillCatalog).&lt;br&gt;• &lt;b&gt;Interviews&lt;/b&gt; are stored on the application (status = Interview Scheduled, interview_at). &lt;b&gt;Mentorship feedback&lt;/b&gt; (rating, feedback) is stored on the session.&lt;br&gt;• &lt;b&gt;application_status_changes&lt;/b&gt; records every stage of an application (FR4.5).&lt;br&gt;• Applications and mentorship sessions use ON DELETE RESTRICT so other users' history is never lost. Chats, alerts and status history cascade with their parent.&lt;br&gt;• Dashed lines are logical references without a database foreign key. Framework tables (sessions, cache, jobs, password_reset_tokens, migrations) are not shown.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Enumerated values&lt;/b&gt;&lt;br&gt;¹ role: jobseeker, employer, mentor, admin&lt;br&gt;² credential_status: not_submitted, pending, verified, rejected, changes_requested&lt;br&gt;³ employer_approval_status: pending, approved, rejected&lt;br&gt;⁴ type: Full-time, Part-time, Contract, Remote&lt;br&gt;⁵ approval_status: pending_approval, approved, rejected, changes_requested&lt;br&gt;⁶ status: Submitted, Under Review, Shortlisted, Interview Scheduled, Rejected, Hired&lt;br&gt;⁷ status: pending, confirmed, completed, cancelled&lt;br&gt;⁸ intent: interview_practice, cv_assistance, mentor_escalation, general_enquiry&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Notation&lt;/b&gt; (crow's foot)&lt;br&gt;One bar = exactly one. Circle and bar = zero or one. Circle and crow's foot = zero or many. Bar and crow's foot = one or many. PK primary key, FK foreign key, UQ unique." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#c3cfdc;spacing=12;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1160" y="1520" width="940" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>